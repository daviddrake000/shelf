rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each person's shelf (books, covers, lists, settings) lives under users/{their uid}
    // and only they can read or change it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Read-only reading feeds for AI assistants (see src/feed.ts). The document id is a
    // long random secret: anyone who knows it can fetch that one document, but nobody can
    // list or search feeds. Only the owner can create, change or delete theirs.
    match /feeds/{feedId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'json', 'updatedAt'])
        && request.resource.data.json is string;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'json', 'updatedAt'])
        && request.resource.data.json is string;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
